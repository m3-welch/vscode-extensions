{
  "name": "ai-dlc-state-tracker",
  "displayName": "AI-DLC State Tracker",
  "description": "View the workspace AI-DLC state as rendered Markdown.",
  "publisher": "m3-welch",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/m3-welch/vscode-extensions.git",
    "directory": "ai-dlc-state-tracker"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-dlc-state-tracker.openTracker",
        "title": "AI-DLC State Tracker: Open"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ai-dlc-state-tracker.stateView",
          "name": "AI-DLC State Tracker",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "vsix": "npm run package && vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "npm run compile-tests && node --test out/test/unit/*.test.js",
    "test:extension-host": "npm run compile-tests && npm run compile && vscode-test",
    "test": "npm run test:unit && npm run test:extension-host"
  },
  "dependencies": {
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/vscode": "~1.90.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6",
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  }
}
